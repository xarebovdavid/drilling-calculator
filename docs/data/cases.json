{
  "description": "Контрольные примеры для docs/js/formulas.js. Все величины в СИ: кг/м³, Па, м, м³, м³/с, с, Н. Ожидаемые значения посчитаны вручную (ход расчёта — в поле calc), g = 9,81 м/с². Сравнение по относительному допуску rtol (для нулевых ожиданий — по абсолютному 1e-12).",
  "rtol": 1e-9,
  "cases": [
    {
      "id": "hydro-1",
      "title": "Гидростатическое давление: ρ = 1,20 г/см³, h = 2500 м",
      "fn": "hydrostaticPressure",
      "args": [1200, 2500],
      "expected": 29430000,
      "calc": "1200 · 9,81 · 2500 = 29 430 000 Па = 29,43 МПа",
      "source": "P = ρgh — Булатов А.И. и др., «Техника и технология бурения нефтяных и газовых скважин», 2003"
    },
    {
      "id": "hydro-2",
      "title": "Гидростатическое давление пресной воды: ρ = 1,00 г/см³, h = 1000 м",
      "fn": "hydrostaticPressure",
      "args": [1000, 1000],
      "expected": 9810000,
      "calc": "1000 · 9,81 · 1000 = 9 810 000 Па = 9,81 МПа (≈ 0,1 МПа на 10 м)",
      "source": "P = ρgh"
    },
    {
      "id": "grad-1",
      "title": "Градиент давления: ρ = 1,15 г/см³",
      "fn": "pressureGradient",
      "args": [1150],
      "expected": 11281.5,
      "calc": "1150 · 9,81 = 11 281,5 Па/м = 0,0112815 МПа/м",
      "source": "grad P = ρg"
    },
    {
      "id": "anomaly-1",
      "title": "Коэффициент аномальности: Pпл = 30 МПа, H = 2800 м",
      "fn": "anomalyCoefficient",
      "args": [30000000, 2800],
      "expected": 1.09217999126256,
      "calc": "30·10⁶ / (1000 · 9,81 · 2800) = 30·10⁶ / 27 468 000 = 1,092180",
      "source": "kа = Pпл / (ρв g H) — Булатов А.И. и др., 2003"
    },
    {
      "id": "ecd-1",
      "title": "ЭЦП: ρ = 1,20 г/см³, ΔPкп = 2,0 МПа, H = 3000 м",
      "fn": "equivalentCirculatingDensity",
      "args": [1200, 2000000, 3000],
      "expected": 1267.9578661230037,
      "calc": "1200 + 2·10⁶ / (9,81 · 3000) = 1200 + 2·10⁶ / 29 430 = 1200 + 67,9579 = 1267,958 кг/м³",
      "source": "ρэкв = ρ + ΔPкп/(gH)"
    },
    {
      "id": "ecd-2",
      "title": "ЭЦП без циркуляции: ΔPкп = 0",
      "fn": "equivalentCirculatingDensity",
      "args": [1100, 0, 1000],
      "expected": 1100,
      "calc": "1100 + 0 = 1100 кг/м³",
      "source": "предельный случай"
    },
    {
      "id": "margin-1",
      "title": "Репрессия, H = 1000 м (≤ 1200 м), Pпл = 10 МПа",
      "fn": "overbalanceMargin",
      "args": [10000000, 1000],
      "expected": { "fraction": 0.1, "cap": 1500000, "dP": 1000000, "limited": false },
      "calc": "10 % · 10 МПа = 1,0 МПа < 1,5 МПа → ΔP = 1,0 МПа",
      "source": "ФНП «Правила безопасности в нефтяной и газовой промышленности» (приказ Ростехнадзора № 534 от 15.12.2020)"
    },
    {
      "id": "margin-2",
      "title": "Репрессия на границе: H = 1200 м относится к интервалу 0–1200 м",
      "fn": "overbalanceMargin",
      "args": [12000000, 1200],
      "expected": { "fraction": 0.1, "cap": 1500000, "dP": 1200000, "limited": false },
      "calc": "10 % · 12 МПа = 1,2 МПа < 1,5 МПа → ΔP = 1,2 МПа",
      "source": "ФНП ПБ НГП, интервал «до 1200 м» включительно"
    },
    {
      "id": "margin-3",
      "title": "Репрессия ограничена сверху: H = 1100 м, Pпл = 20 МПа (АВПД)",
      "fn": "overbalanceMargin",
      "args": [20000000, 1100],
      "expected": { "fraction": 0.1, "cap": 1500000, "dP": 1500000, "limited": true },
      "calc": "10 % · 20 МПа = 2,0 МПа > 1,5 МПа → ΔP = 1,5 МПа",
      "source": "ФНП ПБ НГП"
    },
    {
      "id": "margin-4",
      "title": "Репрессия, H = 2400 м, Pпл = 25 МПа",
      "fn": "overbalanceMargin",
      "args": [25000000, 2400],
      "expected": { "fraction": 0.05, "cap": 2500000, "dP": 1250000, "limited": false },
      "calc": "5 % · 25 МПа = 1,25 МПа < 2,5 МПа → ΔP = 1,25 МПа",
      "source": "ФНП ПБ НГП"
    },
    {
      "id": "margin-5",
      "title": "Репрессия ограничена сверху: H = 4500 м, Pпл = 60 МПа",
      "fn": "overbalanceMargin",
      "args": [60000000, 4500],
      "expected": { "fraction": 0.05, "cap": 2500000, "dP": 2500000, "limited": true },
      "calc": "5 % · 60 МПа = 3,0 МПа > 2,5 МПа → ΔP = 2,5 МПа",
      "source": "ФНП ПБ НГП (предел 2,5–3,0 МПа, по умолчанию 2,5)"
    },
    {
      "id": "margin-6",
      "title": "Репрессия с пределом 3,0 МПа: H = 4500 м, Pпл = 60 МПа",
      "fn": "overbalanceMargin",
      "args": [60000000, 4500, 3000000],
      "expected": { "fraction": 0.05, "cap": 3000000, "dP": 3000000, "limited": false },
      "calc": "5 % · 60 МПа = 3,0 МПа = пределу 3,0 МПа → ΔP = 3,0 МПа",
      "source": "ФНП ПБ НГП"
    },
    {
      "id": "density-1",
      "title": "Плотность раствора: Pпл = 10 МПа, H = 1000 м, ΔP = 1,0 МПа",
      "fn": "requiredMudDensity",
      "args": [10000000, 1000, 1000000],
      "expected": 1121.3047910295618,
      "calc": "(10 + 1)·10⁶ / (9,81 · 1000) = 11·10⁶ / 9810 = 1121,30 кг/м³ ≈ 1,12 г/см³",
      "source": "ρ = (Pпл + ΔP)/(gH)"
    },
    {
      "id": "density-2",
      "title": "Плотность раствора: Pпл = 25 МПа, H = 2400 м, ΔP = 1,25 МПа",
      "fn": "requiredMudDensity",
      "args": [25000000, 2400, 1250000],
      "expected": 1114.9337410805301,
      "calc": "26,25·10⁶ / (9,81 · 2400) = 26,25·10⁶ / 23 544 = 1114,93 кг/м³",
      "source": "ρ = (Pпл + ΔP)/(gH)"
    },
    {
      "id": "density-3",
      "title": "Плотность раствора: Pпл = 60 МПа, H = 4500 м, ΔP = 2,5 МПа",
      "fn": "requiredMudDensity",
      "args": [60000000, 4500, 2500000],
      "expected": 1415.788877562578,
      "calc": "62,5·10⁶ / (9,81 · 4500) = 62,5·10⁶ / 44 145 = 1415,79 кг/м³",
      "source": "ρ = (Pпл + ΔP)/(gH)"
    },
    {
      "id": "pipe-1",
      "title": "Внутренний объём СБТ 127×9,19 мм (dвн = 108,6 мм), L = 1000 м",
      "fn": "pipeVolume",
      "args": [0.1086, 1000],
      "expected": 9.26295452318297,
      "calc": "π/4 · 0,1086² · 1000 = 0,785398 · 0,01179396 · 1000 = 9,263 м³ (9,26 л/м)",
      "source": "V = πd²L/4"
    },
    {
      "id": "annulus-1",
      "title": "Объём затрубья: долото 215,9 мм, трубы 127 мм, L = 1000 м",
      "fn": "annularVolume",
      "args": [0.2159, 0.127, 1000],
      "expected": 23.941928387356768,
      "calc": "π/4 · (0,2159² − 0,127²) · 1000 = 0,785398 · (0,04661281 − 0,016129) · 1000 = 0,785398 · 0,03048381 · 1000 = 23,942 м³",
      "source": "V = π(D² − d²)L/4"
    },
    {
      "id": "hole-1",
      "title": "Объём ствола 215,9 мм без труб, L = 100 м",
      "fn": "holeVolume",
      "args": [0.2159, 100],
      "expected": 3.6609615364794212,
      "calc": "π/4 · 0,04661281 · 100 = 3,661 м³",
      "source": "V = πD²L/4"
    },
    {
      "id": "well-1",
      "title": "Конструкция: 1500 м в колонне 245 мм (dвн 225), 1300 м открытого ствола 215,9 мм на СБТ 127×9,19, 200 м УБТ 178×71,4",
      "fn": "wellVolumes",
      "args": [[
        { "length": 1500, "D": 0.225, "dOut": 0.127, "dIn": 0.1086 },
        { "length": 1300, "D": 0.2159, "dOut": 0.127, "dIn": 0.1086 },
        { "length": 200, "D": 0.2159, "dOut": 0.178, "dIn": 0.0714 }
      ]],
      "expected": {
        "pipe": 26.737058349127047,
        "annulus": 74.10916146154325,
        "hole": 114.55559608018505,
        "steel": 13.709376269514745,
        "total": 100.8462198106703,
        "length": 3000
      },
      "calc": "Vтр = 13,894 + 12,042 + 0,801 = 26,737 м³; Vкп = 40,640 + 31,125 + 2,345 = 74,109 м³; Vств = π/4·(0,225²·1500 + 0,2159²·1500) = 114,556 м³; Vмет = 13,709 м³; Vтр + Vкп = 100,846 м³",
      "source": "сумма по интервалам"
    },
    {
      "id": "time-1",
      "title": "Время выхода забойной пачки: Vкп = 24 м³, Q = 30 л/с",
      "fn": "pumpTime",
      "args": [24, 0.03],
      "expected": 800,
      "calc": "24 / 0,03 = 800 с = 13 мин 20 с",
      "source": "t = V/Q"
    },
    {
      "id": "time-2",
      "title": "Время цикла: Vтр + Vкп + Vпов = 26,737 + 74,109 + 40 м³, Q = 30 л/с",
      "fn": "pumpTime",
      "args": [140.8462198106703, 0.03],
      "expected": 4694.873993689010,
      "calc": "140,846 / 0,03 = 4694,87 с ≈ 78,2 мин",
      "source": "t = V/Q"
    },
    {
      "id": "vel-1",
      "title": "Скорость восходящего потока: Q = 30 л/с, D = 215,9 мм, d = 127 мм",
      "fn": "annularVelocity",
      "args": [0.03, 0.2159, 0.127],
      "expected": 1.2530318992952285,
      "calc": "Sкп = π/4 · 0,03048381 = 0,0239419 м²; v = 0,03 / 0,0239419 = 1,253 м/с",
      "source": "v = 4Q/(π(D² − d²))"
    },
    {
      "id": "buoy-1",
      "title": "Коэффициент плавучести: ρр = 1,20 г/см³, сталь 7,85 г/см³",
      "fn": "buoyancyFactor",
      "args": [1200],
      "expected": 0.8471337579617835,
      "calc": "1 − 1200/7850 = 1 − 0,152866 = 0,847134",
      "source": "k = 1 − ρр/ρст — Булатов А.И. и др., 2003"
    },
    {
      "id": "buoy-2",
      "title": "Коэффициент плавучести в воздухе (ρр = 0) равен 1",
      "fn": "buoyancyFactor",
      "args": [0],
      "expected": 1,
      "calc": "1 − 0 = 1",
      "source": "предельный случай"
    },
    {
      "id": "weight-1",
      "title": "Вес колонны в растворе: q = 29 кг/м, L = 2000 м, ρр = 1,20 г/см³",
      "fn": "buoyedWeight",
      "args": [29, 2000, 1200],
      "expected": 482002.16560509556,
      "calc": "Gвозд = 29 · 2000 · 9,81 = 568 980 Н; Gр = 0,847134 · 568 980 = 482 002 Н ≈ 482,0 кН ≈ 49,2 тс",
      "source": "G = k·q·L·g"
    }
  ]
}
